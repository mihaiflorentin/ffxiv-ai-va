<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.0.6</Version>
    <AssemblyName>AIVoiceActing</AssemblyName>
    <Description>AI voice acting for FFXIV - local neural TTS with emotion-aware delivery.</Description>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Plugin runs inside the Windows FFXIV process (DirectML or CPU, via the DML-capable
         native). Local macOS engine work happens in tools/SmokeSynth, which references the
         full Microsoft.ML.OnnxRuntime core package (osx-arm64 native, CPU+CoreML EPs) —
         never reference core here: its win-x64 CPU-only onnxruntime.dll collides with the
         DirectML package's DML-capable one (publish dedup + build-target copy order pick
         the CPU build, breaking DirectML EP registration in-game). Managed and DirectML
         MUST stay on the same version; the DirectML package tops out at 1.24.4. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Publish output must live OUTSIDE $(OutputPath): DalamudPackager zips the whole
         $(OutputPath) tree when it builds latest.zip at Build time, so a publish/ folder
         inside it gets baked into the zip as a nested duplicate of every file. -->
    <PublishDir>$(BaseOutputPath)publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
    <PackageReference Include="Standart.Hash.xxHash" Version="4.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Domain\voices.json" />
    <EmbeddedResource Include="Infrastructure\Dalamud\overridenModelIds.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="voices\default_voice.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icon.png" Link="icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- DalamudPackager packs everything under $(OutputPath), and the NuGet copy pipeline
       drops a runtimes/ tree there (RID-specific natives, incl. the osx-arm64 tokenizers
       dylib) next to the DirectML package's debug pdb/dll junk. Flatten the natives the
       game actually loads to the output root and delete the rest before packing, so
       latest.zip holds exactly: plugin dll/pdb/deps/manifest, managed deps, required
       natives (onnxruntime, DirectML, providers_shared, hf_tokenizers), icon.png and
       voices/. The RemoveDir also clears stale publish/ folders left by the old
       in-OutputPath PublishDir layout. -->
  <Target Name="PreparePackOutput" BeforeTargets="DefaultDalamudPackagerRelease;DefaultDalamudPackagerDebug">
    <ItemGroup>
      <_RequiredNative Include="$(OutputPath)runtimes/win-x64/native/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_RequiredNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutputPath)runtimes" Condition="Exists('$(OutputPath)runtimes')" />
    <RemoveDir Directories="$(OutputPath)publish" Condition="Exists('$(OutputPath)publish')" />
    <Delete Files="$(OutputPath)DirectML.Debug.dll;$(OutputPath)DirectML.Debug.pdb;$(OutputPath)DirectML.pdb" />
  </Target>
</Project>
