<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyName>AIVoiceActing</AssemblyName>
    <Description>AI voice acting for FFXIV - local neural TTS with emotion-aware delivery.</Description>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- OnnxRuntime core, Managed, and DirectML MUST stay on the same version (the DirectML
         package tops out at 1.24.4). Core and DirectML both ship a win-x64 onnxruntime.dll and
         publish dedup picks ONE copy; verified empirically the copy order picks core's CPU-only
         build, which would break DirectML EP registration in-game. core therefore excludes
         native AND build assets: its build targets inject a None item that re-copies the
         CPU-only onnxruntime.dll over the DirectML build (which contains the CPU EP too). -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" ExcludeAssets="native;build" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
    <PackageReference Include="Standart.Hash.xxHash" Version="4.0.5" />
  </ItemGroup>

</Project>
