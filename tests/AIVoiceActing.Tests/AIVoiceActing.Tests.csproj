<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Standart.Hash.xxHash" Version="4.0.5" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="KokoroSharp" Version="0.8.4" />
    <PackageReference Include="Horus.F5Tts.Onnx" Version="0.3.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
  </ItemGroup>
  <!--
    Why tests compile the Dalamud-free sources instead of referencing the plugin assembly:
    - A net10.0-windows TEST project cannot run on non-Windows hosts (its testhost requires
      the WindowsDesktop shared framework, absent on macOS).
    - The plugin assembly (and Dalamud.dll itself) are x64 PE images; they cannot load into an
      arm64 test host (this Mac is arm64-only, no x64 .NET runtime installed).
    Domain/, Ports/, and Container/ServiceContainer are Dalamud-free by the architecture rule,
    so the unit tests compile them from source; the plugin shell (entry, Infrastructure) is
    covered by the Release build + publish and the in-game checklist.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\AIVoiceActing\Domain\**\*.cs" Link="AIVoiceActing\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Ports\**\*.cs" Link="AIVoiceActing\Ports\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Container\ServiceContainer.cs" Link="AIVoiceActing\ServiceContainer.cs" />
  </ItemGroup>
  <!-- Dalamud-free Infrastructure sources exercised by the tests (mirrors the Domain/Ports
       rule: these three adapters reference no Dalamud namespaces, so they compile and run on
       any OS alongside the pure domain). -->
  <ItemGroup>
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Dalamud\UngenderedModelIds.cs" Link="AIVoiceActing\Infrastructure\UngenderedModelIds.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Dalamud\GameObjectSpeakerDirectory.cs" Link="AIVoiceActing\Infrastructure\GameObjectSpeakerDirectory.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Onnx\**\*.cs" Link="AIVoiceActing\Infrastructure\Onnx\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Kokoro\**\*.cs" Link="AIVoiceActing\Infrastructure\Kokoro\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\F5\**\*.cs" Link="AIVoiceActing\Infrastructure\F5\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Net\HuggingFaceProvisioner.cs" Link="AIVoiceActing\Infrastructure\Net\HuggingFaceProvisioner.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Storage\FileModelStore.cs" Link="AIVoiceActing\Infrastructure\Storage\FileModelStore.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Storage\JsonProfileStore.cs" Link="AIVoiceActing\Infrastructure\Storage\JsonProfileStore.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Text\**\*.cs" Link="AIVoiceActing\Infrastructure\Text\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Step 7: pure UI state (Dalamud- and ImGui-free by the same rule as Domain). -->
    <Compile Include="..\..\src\AIVoiceActing\UI\State\**\*.cs" Link="AIVoiceActing\UI\State\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AIVoiceActing\Configuration.cs" Link="AIVoiceActing\Configuration.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Container\CommandRouter.cs" Link="AIVoiceActing\CommandRouter.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Container\KeybindMonitor.cs" Link="AIVoiceActing\KeybindMonitor.cs" />
    <Compile Include="..\..\src\AIVoiceActing\Infrastructure\Audio\PlaybackSpeechQueue.cs" Link="AIVoiceActing\PlaybackSpeechQueue.cs" />
    <Content Include="..\..\src\AIVoiceActing\Infrastructure\Dalamud\overridenModelIds.txt" Link="overridenModelIds.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\AIVoiceActing\Domain\voices.json" Link="voices.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
